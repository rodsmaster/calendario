{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/calendar",
        "function": "fetchCalendarFeed"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "codebase": "default"
  }
}